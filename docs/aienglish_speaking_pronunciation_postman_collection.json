  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login - Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const authHeader = pm.response.headers.get('authorization');",
                  "if (authHeader) {",
                  "    pm.collectionVariables.set('token', authHeader);",
                  "    console.log('Token saved to collection variable: token');",
                  "} else {",
                  "    console.warn('No authorization header found in response');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"general_user\": {\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/general_users/sign_in.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "general_users",
                "sign_in.json"
              ]
            },
            "description": "登录并从响应头 authorization 中提取 token。"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/general_users/sign_out",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "general_users",
                "sign_out"
              ]
            }
          },
          "response": []
        }
      ]
    },

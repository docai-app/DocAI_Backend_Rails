<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }

    .header {
      background-color: #f8f9fa;
      padding: 15px;
      text-align: center;
    }

    .content {
      padding: 20px;
    }

    .footer {
      background-color: #f8f9fa;
      padding: 15px;
      text-align: center;
      font-size: 12px;
    }

    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }

    .info-table td,
    .info-table th {
      border: 1px solid #ddd;
      padding: 8px;
    }

    .info-table tr:nth-child(even) {
      background-color: #f2f2f2;
    }

    .info-table th {
      padding-top: 12px;
      padding-bottom: 12px;
      text-align: left;
      background-color: #4CAF50;
      color: white;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <h2><%= @notification_title %></h2>
    </div>

    <div class="content">
      <p>Hello Admin,</p>

      <p><%= @recovery_attention ? 'This task needs review. Its previous result could not be confirmed, so no new generation was started. Please verify the original task before retrying.' : (@generation&.kind == 'supplement' ? 'The supplementary exercise failed. The main grading is unchanged.' : 'An assignment has been stopped due to an error.') %> Please find the details below:</p>

      <table class="info-table">
        <tr>
          <th>Field</th>
          <th>Details</th>
        </tr>
        <tr>
          <td>User Email</td>
          <td><%= @user.email %></td>
        </tr>
        <tr>
          <td>User Nickname</td>
          <td><%= @user.nickname %></td>
        </tr>
        <tr>
          <td>Assignment Title</td>
          <td><%= @assignment.title %></td>
        </tr>
        <tr>
          <td>Assignment ID</td>
          <td><%= @assignment.id %></td>
        </tr>
        <tr>
          <td>Essay Grading ID</td>
          <td><%= @essay_grading.id %></td>
        </tr>
        <tr>
          <td><%= @recovery_attention ? 'Review Requested At' : 'Notification Time' %></td>
          <td><%= Time.current %></td>
        </tr>
        <tr>
          <td>AIEnglish 頁面</td>
          <td><a href="https://aienglish.docai.net/essay/assignment/<%= @assignment.id %>" target="_blank">點擊查看</a></td>
        </tr>
        <tr>
          <td>管理後台 頁面</td>
          <td><a href="https://aienglish-admin.docai.net/submissions?assignmentId=<%= @assignment.id %>" target="_blank">點擊查看</a></td>
        </tr>
      </table>
      <% if @generation %>
        <p>Failed Stage: <%= @generation.kind == 'supplement' ? 'Supplementary exercise' : 'Grading (see record for stage details)' %><br>
        Attempts: <%= @generation.attempts %> (including the first attempt)<br>
        <a href="https://aienglish.docai.net/essay/grading/<%= @essay_grading.id %>">View grading record</a></p>
      <% end %>

      <p>Please check the system and take necessary actions.</p>
    </div>

    <div class="footer">
      <p>This is an automated message from AI ENGLISH system.</p>
    </div>
  </div>
</body>

</html>

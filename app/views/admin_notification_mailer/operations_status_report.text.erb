<% @report['assignments'].each do |a| %><%= a['school'] %> | <%= a['teacher'] %> | <%= a['title'] %> | <%= a['category'] %> | <%= a['academic_year'] || '學年未確認' %> | <%= a['created_at'] %>
<%= a['url'] %>
<% end %>
統計說明：
<% @report['definitions'].each do |definition| %>• <%= definition %>

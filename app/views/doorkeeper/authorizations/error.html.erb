<% content_for :title, t('doorkeeper.authorizations.error.title') %>

<section class="oauth-card oauth-card--error" role="alert">
  <div class="oauth-error-icon" aria-hidden="true">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
      <path d="M12 7v6m0 3h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </div>

  <h1 class="oauth-card__title"><%= t('doorkeeper.authorizations.error.title') %></h1>

  <% if @error_description.present? %>
    <p class="oauth-error-message"><%= @error_description %></p>
  <% elsif @error.present? %>
    <p class="oauth-error-message"><%= t(@error, scope: %i[doorkeeper errors messages], default: @error.to_s.humanize) %></p>
  <% end %>

  <p class="oauth-legal"><%= t('doorkeeper.authorizations.error.hint') %></p>
</section>
